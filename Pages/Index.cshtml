@page
@model IndexModel
@using NavidGelato_Site.Services
@{
 ViewData["Title"]="نوید ژلاتو | تجربه شیرین ژلاتو";
 ViewData["Description"]="نوید ژلاتو؛ منوی دیجیتال، طعم‌های متنوع ژلاتو، شعب و راه‌های ارتباطی.";
 ViewData["OgImage"]=SiteContentService.BrandHeroImage;
}
<section class="gelato-hero">
 <div class="container gelato-hero-grid">
  <div class="gelato-hero-copy">
   <span class="gelato-label">NAVID GELATO • SCOOPS OF JOY</span>
   <h1>هر اسکوپ،<br/><em>یه حالِ خوب!</em></h1>
   <p>دنیای رنگارنگ ژلاتو و طعم‌های دوست‌داشتنی. منو رو ببین، شعبه نزدیکت رو پیدا کن و طعم مورد علاقه‌ات رو انتخاب کن.</p>
   <div class="gelato-actions"><a class="gelato-button" asp-page="/Menu">دیدن منو <span>←</span></a><a class="gelato-button secondary" asp-page="/Branches">پیدا کردن شعبه</a></div>
   <span class="gelato-mini-caption">🍓 لطیف، خوش‌رنگ، خوش‌طعم</span>
  </div>
  <div class="gelato-art"><span class="gelato-art-ring"></span><img src="@Url.Content(SiteContentService.BrandHeroImage)" alt="تصویر گرافیکی ژلاتوی رنگارنگ" fetchpriority="high"/><span class="gelato-art-sticker">SWEET<br/>MOMENTS ✦</span></div>
 </div>
</section>
<section class="gelato-ticker"><div class="container">GELATO ✳ خوشمزه ✳ ICE CREAM ✳ لحظه‌های شیرین ✳ NAVID GELATO</div></section>
<section class="gelato-section" id="discover">
 <div class="container"><span class="gelato-label">DISCOVER YOUR FLAVOUR</span><h2>طعمِ لحظه‌هات رو پیدا کن</h2><p class="gelato-section-desc">تصاویر، دسته‌بندی‌ها و قیمت‌های واقعی از پنل مدیریت به منوی دیجیتال اضافه می‌شن.</p>
 <div class="gelato-feature-grid">
  <a class="gelato-feature gelato-feature-rose" asp-page="/Menu"><span>🍦</span><h3>منوی دیجیتال</h3><p>طعم‌ها و قیمت‌ها رو یک‌جا ببین.</p><b>مشاهده منو ←</b></a>
  <a class="gelato-feature gelato-feature-green" asp-page="/Branches"><span>📍</span><h3>شعب نوید ژلاتو</h3><p>نزدیک‌ترین شعبه رو پیدا کن.</p><b>مشاهده شعب ←</b></a>
  <a class="gelato-feature gelato-feature-gold" asp-page="/Franchise"><span>✨</span><h3>همراهِ نوید ژلاتو</h3><p>برای همکاری و فرانچایز اقدام کن.</p><b>درخواست همکاری ←</b></a>
 </div></div>
</section>
<section class="gelato-section gelato-section-alt"><div class="container gelato-story-grid"><div><span class="gelato-label">HELLO SWEETNESS</span><h2>یه دنیا رنگ،<br/>یه دنیا طعم</h2><p>ژلاتو فقط یه خوراکی نیست؛ یه بهونه خوشمزه برای خاطره‌های خوبه. اینجا قراره انتخابت هم راحت باشه، هم هیجان‌انگیز.</p><a class="gelato-button" asp-page="/Menu">کشف طعم‌ها ←</a></div><img src="@Url.Content(SiteContentService.BrandHeroImage)" loading="lazy" alt="طرح ژلاتو"/></div></section>
<section class="gelato-section"><div class="container"><span class="gelato-label">FIND US</span><h2>شعبه نزدیکت کجاست؟</h2>
@if(Model.Branches.Count==0){<div class="gelato-empty">اطلاعات شعب به‌زودی از پنل مدیریت منتشر می‌شه.</div>}
else{<div class="gelato-branches">@foreach(var branch in Model.Branches.Take(6)){<a asp-page="/Branches" asp-fragment="branch-@branch.Id" class="gelato-branch"><strong>@branch.Name</strong><span>@branch.City</span><small>@branch.Address</small></a>}</div>}
<div class="gelato-actions"><a class="gelato-button" asp-page="/Branches">همه شعب ←</a><a class="gelato-button secondary" href="https://www.instagram.com/navid_gelato/" target="_blank" rel="noopener">اینستاگرام ژلاتو ↗</a></div></div></section>