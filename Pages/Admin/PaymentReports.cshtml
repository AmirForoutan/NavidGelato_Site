        body.payment-modal-open{overflow:hidden}.payment-modal[hidden]{display:none!important}.payment-modal{position:fixed;inset:0;z-index:6000;display:grid;place-items:center;padding:28px}.payment-modal-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.76);backdrop-filter:blur(8px)}.payment-modal-dialog{position:relative;z-index:1;width:min(1050px,calc(100vw - 44px));max-height:90vh;overflow:hidden;display:flex;flex-direction:column;background:#131316;border:1px solid #3a3a41;border-radius:22px;box-shadow:0 40px 140px rgba(0,0,0,.78);animation:paymentModalIn .18s ease-out}.payment-modal-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:22px 24px 18px;border-bottom:1px solid #2b2b31;background:#17171b}.payment-modal-head>div{display:grid;gap:5px}.payment-modal-head>div>span{color:#e8192c;font-size:10px}.payment-modal-head h2{margin:0;font-size:22px}.payment-modal-head-meta{display:flex;align-items:center;gap:10px;margin-top:5px}.payment-modal-head-meta b{font-size:13px}.payment-modal-close{width:42px;height:42px;display:grid;place-items:center;flex:0 0 42px;border:1px solid #38383e;border-radius:50%;background:#202024;color:#fff;font-size:25px;line-height:1;cursor:pointer}.payment-modal-close:hover{background:#e8192c;border-color:#e8192c}.payment-modal-body{overflow:auto;padding:22px 24px 26px;display:grid;gap:16px}.payment-modal-section{background:#0e0e11;border:1px solid #29292f;border-radius:15px;padding:16px}.payment-modal-section-head{margin-bottom:13px}.payment-modal-section-head span{display:block;color:#e8192c;font-size:9px;margin-bottom:4px}.payment-modal-section-head h3{margin:0;font-size:14px}.payment-modal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.payment-modal-grid>div{min-width:0;display:grid;gap:6px;background:#121216;border:1px solid #27272c;border-radius:10px;padding:11px}.payment-modal-grid>div.wide{grid-column:1/-1}.payment-modal-grid span{font-size:9px;color:#777780}.payment-modal-grid b{font-size:12px}.payment-modal-grid code{display:block;direction:ltr;text-align:left;white-space:pre-wrap;word-break:break-all;color:#ffabb4;font-size:11px}.payment-modal-error-section pre{margin:0;min-height:58px;max-height:190px;overflow:auto;white-space:pre-wrap;word-break:break-word;background:#121216;border:1px solid #2b2b31;border-radius:10px;padding:12px;color:#bbb;line-height:1.9;font-size:11px}@@keyframes paymentModalIn{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:none}}
        .payment-empty{padding:45px 15px;text-align:center;display:grid;gap:7px}.payment-empty span{color:#777780;font-size:11px}.payment-pagination{display:flex;justify-content:center;align-items:center;gap:14px;margin-top:18px}.payment-pagination a{background:#242429;border:1px solid #34343a;padding:8px 13px;border-radius:9px;color:#fff}.payment-pagination span{color:#85858d;font-size:11px}
        @@media(max-width:1100px){.payment-filter-grid{grid-template-columns:repeat(2,1fr)}.payment-stats-grid{grid-template-columns:repeat(2,1fr)}}@@media(max-width:650px){.payment-report-head{align-items:flex-start;flex-direction:column}.payment-filter-grid{grid-template-columns:1fr}.payment-search-field{grid-column:auto}.payment-stats-grid{grid-template-columns:1fr 1fr}.payment-report-toolbar{flex-direction:column}.payment-stats-grid b{font-size:20px}.payment-modal{padding:10px}.payment-modal-dialog{width:100%;max-height:calc(100dvh - 20px);border-radius:17px}.payment-modal-head{padding:17px}.payment-modal-head h2{font-size:18px}.payment-modal-body{padding:15px}.payment-modal-grid{grid-template-columns:1fr}.payment-modal-grid>div.wide{grid-column:auto}}
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/@@majidh1/jalalidatepicker/dist/jalalidatepicker.min.js"></script>
    <script>
        if (window.jalaliDatepicker) {
            jalaliDatepicker.startWatch({
                selector: 'input[data-jdp]',
                date: true,
                time: false,
                persianDigits: false,
                showTodayBtn: true,
                showEmptyBtn: true,
                showCloseBtn: true,
                zIndex: 4000
            });
        }

        (() => {
            const closeModal = (modal) => {
                if (!modal) return;
                modal.hidden = true;
                modal.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('payment-modal-open');
            };

            document.querySelectorAll('[data-payment-modal-open]').forEach((button) => {
                button.addEventListener('click', () => {
                    const id = button.getAttribute('data-payment-modal-open');
                    const modal = id ? document.getElementById(id) : null;
                    if (!modal) return;

                    modal.hidden = false;
                    modal.setAttribute('aria-hidden', 'false');
                    document.body.classList.add('payment-modal-open');
                    modal.querySelector('.payment-modal-close')?.focus();
                });
            });

            document.querySelectorAll('[data-payment-modal-close]').forEach((button) => {
                button.addEventListener('click', () => closeModal(button.closest('[data-payment-modal]')));
            });

            document.addEventListener('keydown', (event) => {
                if (event.key !== 'Escape') return;
                const modal = document.querySelector('[data-payment-modal]:not([hidden])');
                closeModal(modal);
            });
        })();
    </script>
}
