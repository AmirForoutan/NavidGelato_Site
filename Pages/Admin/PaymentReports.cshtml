        .payment-report-panel{padding:24px 12px}.payment-report-toolbar{padding:0 8px}.payment-report-panel>.admin-table-wrap{margin:0 -4px}.payment-report-table{min-width:1460px}.payment-report-table th,.payment-report-table td{padding:16px 14px}.payment-report-table th{font-size:12px}.payment-report-table td{vertical-align:middle;font-size:12px}.payment-report-table td>small,.payment-report-table td code+small{display:block;color:#74747d;margin-top:6px;font-size:10px}.payment-report-table code{font-size:11px;color:#ff9aa3}.payment-time-stack{display:grid;gap:5px;color:#a4a4ad;font-size:11px;min-width:190px}.nowrap{white-space:nowrap}
