@page
@model NavidGelato_Site.Pages.Admin.PaymentReportsModel
@using NavidGelato_Site.Models
@using NavidGelato_Site.Security
@inject IAdminPermissionService PermissionService
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "گزارش پرداخت‌ها";
    var canDetails = await PermissionService.HasAsync(User, AdminPermissions.PaymentReports.ViewDetails);
    var canExport = await PermissionService.HasAsync(User, AdminPermissions.PaymentReports.Export);
}

<div class="admin-page-head payment-report-head">
    <div>
        <span>گزارش مالی</span>
        <h1>درخواست‌ها و پرداخت‌های آنلاین</h1>
        <p>وضعیت لینک‌های ساخته‌شده، پرداخت‌های موفق، خطاها، انقضاها و پاسخ درگاه را بدون مراجعه به SQL بررسی کنید.</p>
    </div>
    @if (canExport)
    {
        <a class="admin-secondary payment-export-btn" href="@Model.BuildExportUrl()">خروجی Excel از فیلتر فعلی</a>
    }
</div>

<form method="get" class="admin-panel payment-filter">
    <div class="payment-filter-grid">
        <label>
            از تاریخ
            <input asp-for="Filter.DateFrom" data-jdp autocomplete="off" dir="ltr" />
        </label>
        <label>
            تا تاریخ
            <input asp-for="Filter.DateTo" data-jdp autocomplete="off" dir="ltr" />
        </label>
        <label>
            شعبه
            <select asp-for="Filter.BranchId">
                <option value="">همه شعب</option>
                @foreach (var branch in Model.Branches)
                {
                    <option value="@branch.Id">@branch.Name</option>
                }
            </select>
        </label>
        <label>
            وضعیت
            <select asp-for="Filter.Status">
                <option value="">همه وضعیت‌ها</option>
                <option value="@((int)PaymentLinkStatus.Created)">باز نشده</option>
                <option value="@((int)PaymentLinkStatus.Opened)">در حال اتصال به درگاه</option>
                <option value="@((int)PaymentLinkStatus.GatewayReady)">در انتظار پرداخت</option>
                <option value="@((int)PaymentLinkStatus.VerificationPending)">در انتظار تایید بانک</option>
                <option value="@((int)PaymentLinkStatus.Paid)">پرداخت موفق</option>
                <option value="@((int)PaymentLinkStatus.Failed)">ناموفق</option>
                <option value="@((int)PaymentLinkStatus.Expired)">منقضی</option>
            </select>
        </label>
        <label>
            وضعیت باز شدن لینک
            <select asp-for="Filter.Opened">
                <option value="">همه</option>
                <option value="true">باز شده</option>
                <option value="false">باز نشده</option>
            </select>
        </label>
        <label class="payment-search-field">
            جستجو
            <input asp-for="Filter.Search" placeholder="Id، PaymentKey، ResNum، RefNum، TraceNo، موبایل، شبا یا شعبه" />
        </label>
        <label>
            تعداد در صفحه
            <select asp-for="Filter.PageSize">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </label>
    </div>
    <input type="hidden" name="Filter.PageNumber" value="1" />
    <div class="payment-filter-actions">
        <button class="admin-primary" type="submit">اعمال فیلتر</button>
        <a class="admin-secondary" asp-page="/Admin/PaymentReports">امروز / پاک کردن فیلتر</a>
    </div>
    <div asp-validation-summary="All" class="validation-summary"></div>
</form>

<div class="payment-stats-grid">
    <article><span>کل درخواست‌ها</span><b>@Model.Summary.TotalRequests.ToString("N0")</b><small>در بازه انتخاب‌شده</small></article>
    <article><span>مبلغ کل درخواست‌ها</span><b>@Model.Summary.TotalAmount.ToString("N0")</b><small>ریال</small></article>
    <article class="success"><span>پرداخت موفق</span><b>@Model.Summary.PaidCount.ToString("N0")</b><small>@Model.Summary.PaidAmount.ToString("N0") ریال</small></article>
    <article><span>نرخ موفقیت</span><b>@Model.Summary.SuccessRate.ToString("0.0")%</b><small>نسبت به کل درخواست‌ها</small></article>
    <article class="danger"><span>ناموفق</span><b>@Model.Summary.FailedCount.ToString("N0")</b><small>Callback یا Verify ناموفق</small></article>
    <article class="warning"><span>منقضی</span><b>@Model.Summary.ExpiredCount.ToString("N0")</b><small>مهلت پرداخت تمام شده</small></article>
    <article><span>باز نشده</span><b>@Model.Summary.UnopenedCount.ToString("N0")</b><small>لینک هنوز توسط مشتری باز نشده</small></article>
    <article><span>در جریان</span><b>@Model.Summary.PendingCount.ToString("N0")</b><small>هنوز به نتیجه نهایی نرسیده</small></article>
    <article><span>لینک‌های بازشده</span><b>@Model.Summary.OpenedCount.ToString("N0")</b><small>حداقل یک‌بار توسط مشتری باز شده</small></article>
    <article class="warning"><span>در انتظار تایید بانک</span><b>@Model.Summary.VerifyingCount.ToString("N0")</b><small>نیازمند توجه در صورت ماندگاری</small></article>
</div>

<div class="admin-panel payment-report-panel">
    <div class="payment-report-toolbar">
        <div>
            <h2>تراکنش‌ها و درخواست‌ها</h2>
            <small>@Model.TotalRows.ToString("N0") رکورد مطابق فیلتر</small>
        </div>
        <div class="payment-report-legend">
            <span><i class="paid"></i> موفق</span>
            <span><i class="pending"></i> در جریان</span>
            <span><i class="failed"></i> ناموفق/منقضی</span>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="payment-empty">
            <b>رکوردی پیدا نشد.</b>
            <span>بازه تاریخ یا فیلترها را تغییر دهید.</span>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table payment-report-table">
                <thead>
                    <tr>
                        <th>زمان درخواست</th>
                        <th>شعبه</th>
                        <th>شناسه لینک</th>
                        <th>مبلغ</th>
                        <th>وضعیت</th>
                        <th>باز شدن / پرداخت</th>
                        <th>موبایل</th>
                        @if (canDetails)
                        {
                            <th>جزئیات</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    var effectiveStatus = Model.GetEffectiveStatus(item);
                    <tr>
                        <td class="nowrap">@Model.FormatDateTime(item.CreatedAtUtc)</td>
                        <td><b>@item.BranchName</b><small>#@item.BranchId</small></td>
                        <td>
                            <code dir="ltr">@Model.ShortPaymentKey(item.PublicToken)</code>
                            <small dir="ltr">@item.ResNum</small>
                        </td>
                        <td class="nowrap"><b>@item.Amount.ToString("N0")</b><small> ریال</small></td>
                        <td><span class="status @NavidGelato_Site.Pages.Admin.PaymentReportsModel.GetStatusCss(effectiveStatus)">@NavidGelato_Site.Pages.Admin.PaymentReportsModel.GetStatusTitle(effectiveStatus)</span></td>
                        <td>
                            <div class="payment-time-stack">
                                <span>باز: @Model.FormatDateTime(item.OpenedAtUtc)</span>
                                <span>پرداخت: @Model.FormatDateTime(item.PaidAtUtc)</span>
                                @if (item.ExpiresAtUtc.HasValue && effectiveStatus != PaymentLinkStatus.Paid)
                                {
                                    <span>انقضا: @Model.FormatDateTime(item.ExpiresAtUtc)</span>
                                }
                            </div>
                        </td>
                        <td dir="ltr">@(string.IsNullOrWhiteSpace(item.CellNumber) ? "-" : item.CellNumber)</td>
                        @if (canDetails)
                        {
                            <td>
                                <button class="payment-detail-open"
                                        type="button"
                                        data-payment-modal-open="payment-modal-@item.Id">
                                    مشاهده جزئیات
                                </button>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="payment-pagination" aria-label="صفحه‌بندی گزارش">
                @if (Model.Filter.PageNumber > 1)
                {
                    <a href="@Model.BuildPageUrl(Model.Filter.PageNumber - 1)">قبلی</a>
                }

                <span>صفحه @Model.Filter.PageNumber.ToString("N0") از @Model.TotalPages.ToString("N0")</span>

                @if (Model.Filter.PageNumber < Model.TotalPages)
                {
                    <a href="@Model.BuildPageUrl(Model.Filter.PageNumber + 1)">بعدی</a>
                }
            </nav>
        }

        @if (canDetails)
        {
            @foreach (var item in Model.Items)
            {
                var modalStatus = Model.GetEffectiveStatus(item);
                <div class="payment-modal" id="payment-modal-@item.Id" data-payment-modal hidden aria-hidden="true">
                    <div class="payment-modal-backdrop" data-payment-modal-close></div>
                    <section class="payment-modal-dialog"
                             role="dialog"
                             aria-modal="true"
                             aria-labelledby="payment-modal-title-@item.Id">
                        <header class="payment-modal-head">
                            <div>
                                <span>جزئیات تراکنش #@item.Id</span>
                                <h2 id="payment-modal-title-@item.Id">@item.BranchName</h2>
                                <div class="payment-modal-head-meta">
                                    <span class="status @NavidGelato_Site.Pages.Admin.PaymentReportsModel.GetStatusCss(modalStatus)">
                                        @NavidGelato_Site.Pages.Admin.PaymentReportsModel.GetStatusTitle(modalStatus)
                                    </span>
                                    <b>@item.Amount.ToString("N0") ریال</b>
                                </div>
                            </div>
                            <button type="button" class="payment-modal-close" data-payment-modal-close aria-label="بستن">×</button>
                        </header>

                        <div class="payment-modal-body">
                            <section class="payment-modal-section">
                                <div class="payment-modal-section-head">
                                    <span>شناسه‌ها</span>
                                    <h3>اطلاعات تراکنش و درگاه</h3>
                                </div>
                                <div class="payment-modal-grid">
                                    <div class="wide"><span>Payment Key</span><code dir="ltr">@item.PublicToken</code></div>
                                    <div><span>ResNum</span><code dir="ltr">@item.ResNum</code></div>
                                    <div><span>RefNum</span><code dir="ltr">@(item.RefNum ?? "-")</code></div>
                                    <div><span>TraceNo</span><code dir="ltr">@(item.TraceNo ?? "-")</code></div>
                                    <div><span>Gateway Request Id</span><code dir="ltr">@(item.GatewayRequestId ?? "-")</code></div>
                                </div>
                            </section>

                            <section class="payment-modal-section">
                                <div class="payment-modal-section-head">
                                    <span>مالی</span>
                                    <h3>مبلغ و تسویه</h3>
                                </div>
                                <div class="payment-modal-grid">
                                    <div><span>مبلغ درخواستی</span><b>@item.Amount.ToString("N0") ریال</b></div>
                                    <div><span>مبلغ تاییدشده بانک</span><b>@(item.VerifiedAmount.HasValue ? $"{item.VerifiedAmount.Value:N0} ریال" : "-")</b></div>
                                    <div class="wide"><span>شبای Snapshot تسویه</span><code dir="ltr">@item.SettlementIban</code></div>
                                    <div><span>شماره موبایل</span><b dir="ltr">@(item.CellNumber ?? "-")</b></div>
                                    <div><span>Token درگاه دریافت شده؟</span><b>@(item.HasGatewayToken ? "بله" : "خیر")</b></div>
                                </div>
                            </section>

                            <section class="payment-modal-section">
                                <div class="payment-modal-section-head">
                                    <span>زمان‌بندی</span>
                                    <h3>چرخه لینک پرداخت</h3>
                                </div>
                                <div class="payment-modal-grid">
                                    <div><span>ساخت درخواست</span><b>@Model.FormatDateTime(item.CreatedAtUtc)</b></div>
                                    <div><span>اولین باز شدن</span><b>@Model.FormatDateTime(item.OpenedAtUtc)</b></div>
                                    <div><span>زمان انقضا</span><b>@Model.FormatDateTime(item.ExpiresAtUtc)</b></div>
                                    <div><span>زمان پرداخت موفق</span><b>@Model.FormatDateTime(item.PaidAtUtc)</b></div>
                                    <div><span>آخرین Callback</span><b>@Model.FormatDateTime(item.LastCallbackAtUtc)</b></div>
                                    <div><span>شروع درخواست Token</span><b>@Model.FormatDateTime(item.GatewayRequestStartedAtUtc)</b></div>
                                </div>
                            </section>

                            <section class="payment-modal-section payment-modal-error-section">
                                <div class="payment-modal-section-head">
                                    <span>خطا / توضیح</span>
                                    <h3>آخرین وضعیت ثبت‌شده</h3>
                                </div>
                                <pre>@(string.IsNullOrWhiteSpace(item.FailureMessage) ? "خطایی برای این تراکنش ثبت نشده است." : item.FailureMessage)</pre>
                            </section>
                        </div>
                    </section>
                </div>
            }
        }
    }
</div>

