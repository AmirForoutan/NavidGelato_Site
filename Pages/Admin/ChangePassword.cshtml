@page
@model NavidGelato_Site.Pages.Admin.ChangePasswordModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "تغییر رمز عبور";
}
<div class="admin-page-head"><div><span>امنیت حساب</span><h1>تغییر رمز عبور</h1></div></div>
<div class="admin-panel narrow-panel">
    @if (Model.RequiredChange){<div class="admin-alert error">برای ادامه کار با پنل، رمز پیش‌فرض را تغییر دهید.</div>}
    <form method="post" class="admin-form">
        <label>رمز فعلی<input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" /></label>
        <label>رمز جدید<input asp-for="Input.NewPassword" type="password" autocomplete="new-password" /></label>
        <label>تکرار رمز جدید<input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" /></label>
        <div asp-validation-summary="All" class="validation-summary"></div>
        <button class="admin-primary" type="submit">تغییر رمز</button>
    </form>
</div>
