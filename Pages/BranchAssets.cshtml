@page "/branch-assets"
@model NavidGelato_Site.Pages.BranchAssetsModel
@{
    Layout = null;
    ViewData["Title"] = "آرشیو تصاویر محصولات نوید ژلاتو";
    var totalImages = Model.Products.Sum(x => x.Images.Count);
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex" />
    <meta name="referrer" content="no-referrer" />
    <title>آرشیو تصاویر محصولات نوید ژلاتو</title>
    <style>
        :root{color-scheme:dark;--bg:#09090b;--panel:#141417;--panel2:#1a1a1f;--line:#2c2c33;--text:#f5f5f7;--muted:#92929d;--brand:#e8192c;--brand2:#ff5f6e;--ok:#66d8a8}
        *{box-sizing:border-box}
        html{background:var(--bg);scroll-behavior:smooth}

            body {
                margin: 0;
                background: radial-gradient(circle at top right,rgba(232,25,44,.11),transparent 30rem),var(--bg);
                color: var(--text);
                font-family: 'Vazir FD';
                min-height: 100vh
            }

        button,input{font:inherit}
        a{text-decoration:none;color:inherit}
        .shell{width:min(1320px,calc(100% - 32px));margin:auto;padding:26px 0 48px}
        .topbar{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:15px 18px;border:1px solid var(--line);background:rgba(20,20,23,.92);border-radius:18px;position:sticky;top:12px;z-index:20;backdrop-filter:blur(14px);box-shadow:0 18px 55px rgba(0,0,0,.25)}
        .brand{display:flex;align-items:center;gap:12px;min-width:0}
        .brand img{width:52px;height:52px;object-fit:contain;border-radius:13px;background:#fff}
        .brand-copy{display:grid;gap:3px}.brand-copy b{font-size:15px}.brand-copy span{font-size:10px;color:var(--muted)}
        .counter{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:11px;white-space:nowrap}.counter b{color:#fff;font-size:16px}
        .hero{padding:52px 6px 26px;display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,420px);gap:30px;align-items:end}
        .hero-copy span{display:inline-flex;color:var(--brand2);font-size:11px;font-weight:800;margin-bottom:10px}.hero h1{font-size:clamp(27px,5vw,48px);line-height:1.35;margin:0 0 12px}.hero p{margin:0;max-width:720px;color:var(--muted);font-size:13px;line-height:2}
        .search-box{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:13px;display:grid;gap:8px}.search-box label{font-size:10px;color:var(--muted)}.search-box input{width:100%;background:#0d0d10;color:#fff;border:1px solid #33333a;border-radius:11px;padding:12px 13px;outline:none}.search-box input:focus{border-color:var(--brand)}
        .notice{display:flex;align-items:flex-start;gap:10px;border:1px solid #39321e;background:#17140d;border-radius:13px;padding:12px 14px;margin-bottom:22px;color:#c9bd8d;font-size:11px;line-height:1.9}.notice b{color:#f2d878;white-space:nowrap}
        .empty{padding:60px 20px;text-align:center;border:1px dashed var(--line);border-radius:18px;color:var(--muted)}
        .products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
        .product-card{border:1px solid var(--line);background:linear-gradient(180deg,#151519,#101013);border-radius:20px;overflow:hidden;box-shadow:0 20px 55px rgba(0,0,0,.22)}
        .product-card[hidden]{display:none}
        .product-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding:17px 18px;border-bottom:1px solid var(--line)}
        .product-title{min-width:0}.product-title small{display:block;color:var(--brand2);font-size:9px;margin-bottom:5px}.product-title h2{margin:0;font-size:17px;line-height:1.6}.meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}.pill{display:inline-flex;padding:4px 7px;border-radius:999px;background:#222228;color:#aaaab4;font-size:9px}.pill.off{color:#ff9ba4;background:#2b171b}.image-count{font-size:10px;color:var(--muted);white-space:nowrap;padding-top:4px}
        .image-list{display:grid;gap:12px;padding:14px}
        .image-row{display:grid;grid-template-columns:116px minmax(0,1fr);gap:14px;align-items:center;background:#0d0d10;border:1px solid #27272d;border-radius:14px;padding:10px}
        .thumb{position:relative;width:116px;aspect-ratio:1/1;background:#fff;border-radius:10px;overflow:hidden}.thumb img{width:100%;height:100%;object-fit:cover;display:block}.primary{position:absolute;right:6px;top:6px;background:rgba(7,7,9,.84);border:1px solid rgba(255,255,255,.15);border-radius:999px;padding:4px 7px;font-size:8px;color:#fff}
        .image-info{min-width:0;display:grid;gap:8px}.image-info strong{font-size:12px;line-height:1.8}.image-info code{direction:ltr;text-align:left;display:block;color:#777781;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.download{display:inline-flex;align-items:center;justify-content:center;width:max-content;max-width:100%;background:var(--brand);color:#fff;border:1px solid var(--brand);border-radius:10px;padding:9px 13px;font-size:11px;font-weight:800;transition:.18s}.download:hover{background:#ff3044;border-color:#ff3044;transform:translateY(-1px)}.download span{opacity:.76;font-weight:400;margin-right:7px}
        .no-results{display:none;margin-top:18px;padding:28px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:16px}.no-results.show{display:block}
        .footer-note{text-align:center;color:#5f5f68;font-size:9px;margin-top:30px;line-height:1.9}
        @@media(max-width:900px){.hero{grid-template-columns:1fr}.products{grid-template-columns:1fr}.topbar{position:static}}
        @@media(max-width:560px){.shell{width:min(100% - 18px,1320px);padding-top:9px}.topbar{padding:11px}.brand img{width:44px;height:44px}.counter{display:none}.hero{padding-top:34px}.hero h1{font-size:28px}.product-head{padding:14px}.image-row{grid-template-columns:90px minmax(0,1fr);gap:10px}.thumb{width:90px}.download{width:100%}}
    </style>
</head>
<body>
    <div class="shell">
        <header class="topbar">
            <div class="brand">
                <img src="@Url.Content("~/img/logo.png")" alt="لوگوی نوید ژلاتو" />
                <div class="brand-copy">
                    <b>NAVID GELATO</b>
                    <span>آرشیو داخلی تصاویر محصولات</span>
                </div>
            </div>
            <div class="counter">
                <b>@Model.Products.Count.ToString("N0")</b> کالا
                <span>•</span>
                <b>@totalImages.ToString("N0")</b> تصویر
            </div>
        </header>

        <section class="hero">
            <div class="hero-copy">
                <span>ویژه مدیران شعب</span>
                <h1>دانلود تصاویر محصولات</h1>
                <p>نام کالا را پیدا کنید و تصویر موردنظر را دانلود کنید. فایل دانلودشده با نام خود کالا ذخیره می‌شود تا برای استفاده در شبکه‌های اجتماعی، منوها و تبلیغات راحت‌تر باشد.</p>
            </div>
            <div class="search-box">
                <label for="asset-search">جستجو در نام کالا، دسته‌بندی یا کد کالا</label>
                <input id="asset-search" type="search" autocomplete="off" placeholder="مثلاً نام ساندویچ..." data-asset-search />
            </div>
        </section>

        <div class="notice">
            <b>راهنما</b>
            <span>اگر یک کالا چند تصویر داشته باشد، تصویر اصلی با نام کالا و تصاویر بعدی با شماره ۲، ۳ و ... دانلود می‌شوند.</span>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="empty">در حال حاضر تصویری برای کالاها ثبت نشده است.</div>
        }
        else
        {
            <section class="products" data-products>
                @foreach (var product in Model.Products)
                {
                    var searchText = $"{product.Name} {product.CategoryName} {product.ProductCode}";
                    <article class="product-card" data-product-card data-search="@searchText">
                        <header class="product-head">
                            <div class="product-title">
                                <small>@product.CategoryName</small>
                                <h2>@product.Name</h2>
                                <div class="meta">
                                    @if (product.ProductCode.HasValue)
                                    {
                                        <span class="pill">کد کالا: @product.ProductCode</span>
                                    }
                                    @if (!product.IsActive)
                                    {
                                        <span class="pill off">غیرفعال در سایت</span>
                                    }
                                </div>
                            </div>
                            <span class="image-count">@product.Images.Count.ToString("N0") تصویر</span>
                        </header>

                        <div class="image-list">
                            @for (var index = 0; index < product.Images.Count; index++)
                            {
                                var image = product.Images[index];
                                var imageUrl = Model.GetImageUrl(image.FilePath);
                                var number = index + 1;
                                <div class="image-row">
                                    <a class="thumb" href="@imageUrl" target="_blank" rel="noopener noreferrer" aria-label="مشاهده تصویر @product.Name">
                                        <img src="@imageUrl" loading="lazy" alt="@product.Name" />
                                        @if (image.IsPrimary)
                                        {
                                            <span class="primary">تصویر اصلی</span>
                                        }
                                    </a>
                                    <div class="image-info">
                                        <strong>@product.Name @(product.Images.Count > 1 ? $"• تصویر {number}" : "")</strong>
                                        <code>@image.FilePath</code>
                                        <a class="download"
                                           href="@imageUrl"
                                           download>
                                            دانلود عکس
                                            <span>↓</span>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </article>
                }
            </section>
            <div class="no-results" data-no-results>کالایی با این عبارت پیدا نشد.</div>
        }

        <p class="footer-note">این صفحه در منوها و صفحات عمومی نوید ژلاتو نمایش داده نمی‌شود و برای استفاده داخلی شعب در نظر گرفته شده است.</p>
    </div>

    <script>
        (() => {
            const input = document.querySelector('[data-asset-search]');
            const cards = Array.from(document.querySelectorAll('[data-product-card]'));
            const empty = document.querySelector('[data-no-results]');
            if (!input || cards.length === 0) return;

            const normalize = (value) => (value || '')
                .toLocaleLowerCase('fa')
                .replaceAll('ي', 'ی')
                .replaceAll('ك', 'ک')
                .replace(/\s+/g, ' ')
                .trim();

            input.addEventListener('input', () => {
                const query = normalize(input.value);
                let visible = 0;

                cards.forEach((card) => {
                    const matches = !query || normalize(card.dataset.search).includes(query);
                    card.hidden = !matches;
                    if (matches) visible++;
                });

                empty?.classList.toggle('show', visible === 0);
            });
        })();
    </script>
</body>
</html>
